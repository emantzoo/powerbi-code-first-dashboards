    m.DisplayFolder = @"RAG Indicators";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Script Deviation RAG -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Days Rx to Contact") ? mt.Measures[@"Avg Days Rx to Contact"] : mt.AddMeasure(@"Avg Days Rx to Contact");
    m.Expression = @"CALCULATE(AVERAGEX(FactPatientCases, DATEDIFF(FactPatientCases[RxDate], FactPatientCases[FirstContactDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Access Bottleneck";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Days Rx to Contact -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Days Contact to PA Submit") ? mt.Measures[@"Avg Days Contact to PA Submit"] : mt.AddMeasure(@"Avg Days Contact to PA Submit");
    m.Expression = @"CALCULATE(AVERAGEX(FactPatientCases, DATEDIFF(FactPatientCases[FirstContactDate], FactPatientCases[PASubmitDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Access Bottleneck";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Days Contact to PA Submit -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Days PA Submit to Decision") ? mt.Measures[@"Avg Days PA Submit to Decision"] : mt.AddMeasure(@"Avg Days PA Submit to Decision");
    m.Expression = @"CALCULATE(AVERAGEX(FILTER(FactPatientCases, NOT(ISBLANK(FactPatientCases[PADecisionDate]))), DATEDIFF(FactPatientCases[PASubmitDate], FactPatientCases[PADecisionDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Access Bottleneck";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Days PA Submit to Decision -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Days Decision to Fulfillment") ? mt.Measures[@"Avg Days Decision to Fulfillment"] : mt.AddMeasure(@"Avg Days Decision to Fulfillment");
    m.Expression = @"CALCULATE(AVERAGEX(FILTER(FactPatientCases, NOT(ISBLANK(FactPatientCases[FulfillmentDate]))), DATEDIFF(FactPatientCases[PADecisionDate], FactPatientCases[FulfillmentDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Access Bottleneck";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Days Decision to Fulfillment -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Days Fulfillment to First Dose") ? mt.Measures[@"Avg Days Fulfillment to First Dose"] : mt.AddMeasure(@"Avg Days Fulfillment to First Dose");
    m.Expression = @"CALCULATE(AVERAGEX(FILTER(FactPatientCases, NOT(ISBLANK(FactPatientCases[FirstDoseDate]))), DATEDIFF(FactPatientCases[FulfillmentDate], FactPatientCases[FirstDoseDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Access Bottleneck";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Days Fulfillment to First Dose -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Total Handling Minutes") ? mt.Measures[@"Total Handling Minutes"] : mt.AddMeasure(@"Total Handling Minutes");
    m.Expression = @"SUM(FactHCPCalls[AHT_Minutes])";
    m.DisplayFolder = @"Selling Time vs Admin";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Total Handling Minutes -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Selling Minutes") ? mt.Measures[@"Selling Minutes"] : mt.AddMeasure(@"Selling Minutes");
    m.Expression = @"CALCULATE(SUM(FactHCPCalls[DurationMinutes]), FactHCPCalls[IsConnected] = 1)";
    m.DisplayFolder = @"Selling Time vs Admin";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Selling Minutes -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Selling Time Pct") ? mt.Measures[@"Selling Time Pct"] : mt.AddMeasure(@"Selling Time Pct");
    m.Expression = @"DIVIDE([Selling Minutes], [Total Handling Minutes], 0)";
    m.DisplayFolder = @"Selling Time vs Admin";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Selling Time Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Admin Time Pct") ? mt.Measures[@"Admin Time Pct"] : mt.AddMeasure(@"Admin Time Pct");
    m.Expression = @"DIVIDE(SUM(FactHCPCalls[AfterCallWorkMinutes]), [Total Handling Minutes], 0)";
    m.DisplayFolder = @"Selling Time vs Admin";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Admin Time Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Positive Sentiment Pct") ? mt.Measures[@"Positive Sentiment Pct"] : mt.AddMeasure(@"Positive Sentiment Pct");
    m.Expression = @"DIVIDE(
    CALCULATE([Total Calls], FactHCPCalls[SentimentBand] = ""Positive""),
    CALCULATE([Total Calls], NOT(ISBLANK(FactHCPCalls[HCPSentimentScore]))), 0)";
    m.DisplayFolder = @"Sentiment & Insight Engine";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Positive Sentiment Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Negative Sentiment Pct") ? mt.Measures[@"Negative Sentiment Pct"] : mt.AddMeasure(@"Negative Sentiment Pct");
    m.Expression = @"DIVIDE(
    CALCULATE([Total Calls], FactHCPCalls[SentimentBand] = ""Negative""),
    CALCULATE([Total Calls], NOT(ISBLANK(FactHCPCalls[HCPSentimentScore]))), 0)";
    m.DisplayFolder = @"Sentiment & Insight Engine";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Negative Sentiment Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Uplift") ? mt.Measures[@"Avg Uplift"] : mt.AddMeasure(@"Avg Uplift");
    m.Expression = @"AVERAGE(FactUplift[uplift])";
    m.DisplayFolder = @"Sentiment & Insight Engine";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Uplift -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Importance") ? mt.Measures[@"Avg Importance"] : mt.AddMeasure(@"Avg Importance");
    m.Expression = @"AVERAGE(FeatureImportance[importance])";
    m.DisplayFolder = @"Sentiment & Insight Engine";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Importance -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Shap Importance") ? mt.Measures[@"Avg Shap Importance"] : mt.AddMeasure(@"Avg Shap Importance");
    m.Expression = @"AVERAGE(ShapImportance[mean_abs_shap])";
    m.DisplayFolder = @"Sentiment & Insight Engine";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Shap Importance -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Last Data Date") ? mt.Measures[@"Last Data Date"] : mt.AddMeasure(@"Last Data Date");
    m.Expression = @"CALCULATE(MAX(FactHCPCalls[CallDate]), ALL(FactHCPCalls), ALL(DimCalendar))";
    m.DisplayFolder = @"Recent Activity — as-of latest data date";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Last Data Date -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Calls Last 7 Days") ? mt.Measures[@"Calls Last 7 Days"] : mt.AddMeasure(@"Calls Last 7 Days");
    m.Expression = @"CALCULATE([Total Calls], DATESINPERIOD(DimCalendar[Date], [Last Data Date], -7, DAY))";
    m.DisplayFolder = @"Recent Activity — as-of latest data date";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Calls Last 7 Days -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Calls Prior 7 Days") ? mt.Measures[@"Calls Prior 7 Days"] : mt.AddMeasure(@"Calls Prior 7 Days");
    m.Expression = @"CALCULATE([Total Calls], DATESINPERIOD(DimCalendar[Date], [Last Data Date] - 7, -7, DAY))";
    m.DisplayFolder = @"Recent Activity — as-of latest data date";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Calls Prior 7 Days -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Calls WoW Change") ? mt.Measures[@"Calls WoW Change"] : mt.AddMeasure(@"Calls WoW Change");
    m.Expression = @"DIVIDE([Calls Last 7 Days] - [Calls Prior 7 Days], [Calls Prior 7 Days], 0)";
    m.DisplayFolder = @"Recent Activity — as-of latest data date";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Calls WoW Change -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Connect Rate Last 7 Days") ? mt.Measures[@"Connect Rate Last 7 Days"] : mt.AddMeasure(@"Connect Rate Last 7 Days");
    m.Expression = @"CALCULATE([Connect Rate], DATESINPERIOD(DimCalendar[Date], [Last Data Date], -7, DAY))";
    m.DisplayFolder = @"Recent Activity — as-of latest data date";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Connect Rate Last 7 Days -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Cases First Contacted") ? mt.Measures[@"Cases First Contacted"] : mt.AddMeasure(@"Cases First Contacted");
    m.Expression = @"CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[FirstContactDate])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Funnel Stage Counts";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Cases First Contacted -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Cases PA Submitted") ? mt.Measures[@"Cases PA Submitted"] : mt.AddMeasure(@"Cases PA Submitted");
    m.Expression = @"CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[PASubmitDate])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Funnel Stage Counts";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Cases PA Submitted -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Cases PA Approved") ? mt.Measures[@"Cases PA Approved"] : mt.AddMeasure(@"Cases PA Approved");
    m.Expression = @"CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[PAStatus] = ""Approved"", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Funnel Stage Counts";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Cases PA Approved -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Cases Fulfilled") ? mt.Measures[@"Cases Fulfilled"] : mt.AddMeasure(@"Cases Fulfilled");
    m.Expression = @"CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[FulfillmentDate])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Funnel Stage Counts";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Cases Fulfilled -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Cases On Therapy") ? mt.Measures[@"Cases On Therapy"] : mt.AddMeasure(@"Cases On Therapy");
    m.Expression = @"CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[FirstDoseDate])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Patient Funnel Stage Counts";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Cases On Therapy -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Open High Risk Cases") ? mt.Measures[@"Open High Risk Cases"] : mt.AddMeasure(@"Open High Risk Cases");
    m.Expression = @"CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[Open Case Age Bucket] = ""14d+"", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Open-Case Aging";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Open High Risk Cases -> " + ex.Message); }

// ---- Calculated columns ----
try {
    var t = Model.Tables["DimRep"];
    if (!t.Columns.Contains(@"Performance Tier")) t.AddCalculatedColumn(@"Performance Tier", @"VAR Total = COUNTROWS(ALL(DimRep))
VAR Rnk = RANKX(ALL(DimRep), CALCULATE([Meaningful Interactions]), , DESC)
RETURN IF(Rnk <= ROUNDUP(Total * 0.2, 0), ""Top 20%"", ""Rest"")");
    else ((CalculatedColumn)t.Columns[@"Performance Tier"]).Expression = @"VAR Total = COUNTROWS(ALL(DimRep))
VAR Rnk = RANKX(ALL(DimRep), CALCULATE([Meaningful Interactions]), , DESC)
RETURN IF(Rnk <= ROUNDUP(Total * 0.2, 0), ""Top 20%"", ""Rest"")";
    cAdded++;
} catch (Exception ex) { Info("Calc column failed: Performance Tier -> " + ex.Message); }
try {
    var t = Model.Tables["DimRep"];
    if (!t.Columns.Contains(@"Tenure Bucket")) t.AddCalculatedColumn(@"Tenure Bucket", @"SWITCH(TRUE(),
    DimRep[TenureMonths] < 6, ""0-6mo"",
    DimRep[TenureMonths] < 12, ""6-12mo"",
    DimRep[TenureMonths] < 18, ""12-18mo"",
    ""18+mo"")");
    else ((CalculatedColumn)t.Columns[@"Tenure Bucket"]).Expression = @"SWITCH(TRUE(),
    DimRep[TenureMonths] < 6, ""0-6mo"",
    DimRep[TenureMonths] < 12, ""6-12mo"",
    DimRep[TenureMonths] < 18, ""12-18mo"",
    ""18+mo"")";
    cAdded++;
} catch (Exception ex) { Info("Calc column failed: Tenure Bucket -> " + ex.Message); }
try {
    var t = Model.Tables["FactHCPCalls"];
    if (!t.Columns.Contains(@"CallTimeBucket")) t.AddCalculatedColumn(@"CallTimeBucket", @"VAR h = VALUE(LEFT(FactHCPCalls[CallTime], 2))
RETURN SWITCH(TRUE(), h < 18, ""16-18"", h < 20, ""18-20"", h < 22, ""20-22"", ""22-00"")");
    else ((CalculatedColumn)t.Columns[@"CallTimeBucket"]).Expression = @"VAR h = VALUE(LEFT(FactHCPCalls[CallTime], 2))
RETURN SWITCH(TRUE(), h < 18, ""16-18"", h < 20, ""18-20"", h < 22, ""20-22"", ""22-00"")";
    cAdded++;
} catch (Exception ex) { Info("Calc column failed: CallTimeBucket -> " + ex.Message); }
try {
    var t = Model.Tables["FactHCPCalls"];
    if (!t.Columns.Contains(@"SentimentBand")) t.AddCalculatedColumn(@"SentimentBand", @"SWITCH(TRUE(),
    ISBLANK(FactHCPCalls[HCPSentimentScore]), BLANK(),
    FactHCPCalls[HCPSentimentScore] >= 4, ""Positive"",
    FactHCPCalls[HCPSentimentScore] >= 2.5, ""Neutral"",
    ""Negative"")");
    else ((CalculatedColumn)t.Columns[@"SentimentBand"]).Expression = @"SWITCH(TRUE(),
    ISBLANK(FactHCPCalls[HCPSentimentScore]), BLANK(),
    FactHCPCalls[HCPSentimentScore] >= 4, ""Positive"",
    FactHCPCalls[HCPSentimentScore] >= 2.5, ""Neutral"",
    ""Negative"")";
    cAdded++;
} catch (Exception ex) { Info("Calc column failed: SentimentBand -> " + ex.Message); }
try {
    var t = Model.Tables["FactPatientCases"];
    if (!t.Columns.Contains(@"Open Case Age Bucket")) t.AddCalculatedColumn(@"Open Case Age Bucket", @"VAR AsOf = CALCULATE(MAX(FactHCPCalls[CallDate]), ALL(FactHCPCalls))
VAR d = DATEDIFF(FactPatientCases[RxDate], AsOf, DAY)
RETURN IF(NOT(FactPatientCases[CaseStatus] IN {""Open"", ""In Progress""}), BLANK(),
    SWITCH(TRUE(), d < 3, ""<3d"", d < 7, ""3-7d"", d < 14, ""7-14d"", ""14d+""))");
    else ((CalculatedColumn)t.Columns[@"Open Case Age Bucket"]).Expression = @"VAR AsOf = CALCULATE(MAX(FactHCPCalls[CallDate]), ALL(FactHCPCalls))
VAR d = DATEDIFF(FactPatientCases[RxDate], AsOf, DAY)
RETURN IF(NOT(FactPatientCases[CaseStatus] IN {""Open"", ""In Progress""}), BLANK(),
    SWITCH(TRUE(), d < 3, ""<3d"", d < 7, ""3-7d"", d < 14, ""7-14d"", ""14d+""))";
    cAdded++;
} catch (Exception ex) { Info("Calc column failed: Open Case Age Bucket -> " + ex.Message); }
try {
    var t = Model.Tables["DimRep"];
    if (!t.Columns.Contains(@"AI Adoption Band")) t.AddCalculatedColumn(@"AI Adoption Band", @"VAR r = CALCULATE(DIVIDE(CALCULATE(COUNTROWS(FactHCPCalls), FactHCPCalls[AIFollowed] = 1), COUNTROWS(FactHCPCalls)))
RETURN SWITCH(TRUE(), r >= 0.5, ""High"", r >= 0.3, ""Medium"", ""Low"")");
    else ((CalculatedColumn)t.Columns[@"AI Adoption Band"]).Expression = @"VAR r = CALCULATE(DIVIDE(CALCULATE(COUNTROWS(FactHCPCalls), FactHCPCalls[AIFollowed] = 1), COUNTROWS(FactHCPCalls)))
RETURN SWITCH(TRUE(), r >= 0.5, ""High"", r >= 0.3, ""Medium"", ""Low"")";
    cAdded++;
} catch (Exception ex) { Info("Calc column failed: AI Adoption Band -> " + ex.Message); }

