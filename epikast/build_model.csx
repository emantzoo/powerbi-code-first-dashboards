    m.Expression = @"DIVIDE([Total Calls], DISTINCTCOUNT(FactHCPCalls[RepID]) * DISTINCTCOUNT(FactHCPCalls[CallDate]), 0)";
    m.DisplayFolder = @"Ops Efficiency";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Calls Per Rep Per Day -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Connected Calls Per Rep Per Day") ? mt.Measures[@"Connected Calls Per Rep Per Day"] : mt.AddMeasure(@"Connected Calls Per Rep Per Day");
    m.Expression = @"DIVIDE([Connected Calls], DISTINCTCOUNT(FactHCPCalls[RepID]) * DISTINCTCOUNT(FactHCPCalls[CallDate]), 0)";
    m.DisplayFolder = @"Ops Efficiency";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Connected Calls Per Rep Per Day -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Meaningful Per Rep Per Day") ? mt.Measures[@"Meaningful Per Rep Per Day"] : mt.AddMeasure(@"Meaningful Per Rep Per Day");
    m.Expression = @"DIVIDE([Meaningful Interactions], DISTINCTCOUNT(FactHCPCalls[RepID]) * DISTINCTCOUNT(FactHCPCalls[CallDate]), 0)";
    m.DisplayFolder = @"Ops Efficiency";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Meaningful Per Rep Per Day -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Notes Compliance Rate") ? mt.Measures[@"Notes Compliance Rate"] : mt.AddMeasure(@"Notes Compliance Rate");
    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[NotesTaken] = 1), [Connected Calls], 0)";
    m.DisplayFolder = @"Ops Efficiency";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Notes Compliance Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Total Rx") ? mt.Measures[@"Total Rx"] : mt.AddMeasure(@"Total Rx");
    m.Expression = @"CALCULATE(COUNTROWS(FactRx), USERELATIONSHIP(FactRx[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Prescriptions";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Total Rx -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"New to Brand Rx") ? mt.Measures[@"New to Brand Rx"] : mt.AddMeasure(@"New to Brand Rx");
    m.Expression = @"CALCULATE(COUNTROWS(FactRx), FactRx[IsNewToBrand] = 1, USERELATIONSHIP(FactRx[RxDate], DimCalendar[Date]))";
    m.DisplayFolder = @"Prescriptions";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: New to Brand Rx -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"NBRx Rate") ? mt.Measures[@"NBRx Rate"] : mt.AddMeasure(@"NBRx Rate");
    m.Expression = @"DIVIDE([New to Brand Rx], [Total Rx], 0)";
    m.DisplayFolder = @"Prescriptions";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: NBRx Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Rx Per HCP") ? mt.Measures[@"Rx Per HCP"] : mt.AddMeasure(@"Rx Per HCP");
    m.Expression = @"DIVIDE([Total Rx], DISTINCTCOUNT(FactRx[HCPID]), 0)
Rx from Engaged HCPs =";
    m.DisplayFolder = @"Prescriptions";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Rx Per HCP -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"VAR EngagedHCPs") ? mt.Measures[@"VAR EngagedHCPs"] : mt.AddMeasure(@"VAR EngagedHCPs");
    m.Expression = @"CALCULATETABLE(VALUES(FactHCPCalls[HCPID]), FactHCPCalls[IsConnected] = 1)
RETURN CALCULATE(COUNTROWS(FactRx), USERELATIONSHIP(FactRx[RxDate], DimCalendar[Date]), TREATAS(EngagedHCPs, FactRx[HCPID]))";
    m.DisplayFolder = @"Prescriptions";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: VAR EngagedHCPs -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Rx from Non-Engaged HCPs") ? mt.Measures[@"Rx from Non-Engaged HCPs"] : mt.AddMeasure(@"Rx from Non-Engaged HCPs");
    m.Expression = @"[Total Rx] - [Rx from Engaged HCPs]
NBRx from Engaged HCPs =";
    m.DisplayFolder = @"Prescriptions";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Rx from Non-Engaged HCPs -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"VAR EngagedHCPs") ? mt.Measures[@"VAR EngagedHCPs"] : mt.AddMeasure(@"VAR EngagedHCPs");
    m.Expression = @"CALCULATETABLE(VALUES(FactHCPCalls[HCPID]), FactHCPCalls[IsConnected] = 1)
RETURN CALCULATE(COUNTROWS(FactRx), FactRx[IsNewToBrand] = 1, USERELATIONSHIP(FactRx[RxDate], DimCalendar[Date]), TREATAS(EngagedHCPs, FactRx[HCPID]))";
    m.DisplayFolder = @"Prescriptions";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: VAR EngagedHCPs -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Total MSL Queries") ? mt.Measures[@"Total MSL Queries"] : mt.AddMeasure(@"Total MSL Queries");
    m.Expression = @"CALCULATE(COUNTROWS(FactMSLPartnerUsage), USERELATIONSHIP(FactMSLPartnerUsage[UsageDate], DimCalendar[Date]))";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Total MSL Queries -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"MSL Queries Per Day") ? mt.Measures[@"MSL Queries Per Day"] : mt.AddMeasure(@"MSL Queries Per Day");
    m.Expression = @"DIVIDE([Total MSL Queries], DISTINCTCOUNT(FactMSLPartnerUsage[UsageDate]), 0)";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: MSL Queries Per Day -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"MSL Queries Per MSL Per Day") ? mt.Measures[@"MSL Queries Per MSL Per Day"] : mt.AddMeasure(@"MSL Queries Per MSL Per Day");
    m.Expression = @"DIVIDE([Total MSL Queries], DISTINCTCOUNT(FactMSLPartnerUsage[RepID]) * DISTINCTCOUNT(FactMSLPartnerUsage[UsageDate]), 0)";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: MSL Queries Per MSL Per Day -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Fully Answered Rate") ? mt.Measures[@"Fully Answered Rate"] : mt.AddMeasure(@"Fully Answered Rate");
    m.Expression = @"DIVIDE(CALCULATE(COUNTROWS(FactMSLPartnerUsage), FactMSLPartnerUsage[AnswerQuality] = ""Fully Answered""), [Total MSL Queries], 0)";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Fully Answered Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Partially Answered Rate") ? mt.Measures[@"Partially Answered Rate"] : mt.AddMeasure(@"Partially Answered Rate");
    m.Expression = @"DIVIDE(CALCULATE(COUNTROWS(FactMSLPartnerUsage), FactMSLPartnerUsage[AnswerQuality] = ""Partially Answered""), [Total MSL Queries], 0)";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Partially Answered Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"No Answer Rate") ? mt.Measures[@"No Answer Rate"] : mt.AddMeasure(@"No Answer Rate");
    m.Expression = @"DIVIDE(CALCULATE(COUNTROWS(FactMSLPartnerUsage), FactMSLPartnerUsage[AnswerQuality] = ""No Answer Found""), [Total MSL Queries], 0)";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: No Answer Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Time to Answer Sec") ? mt.Measures[@"Avg Time to Answer Sec"] : mt.AddMeasure(@"Avg Time to Answer Sec");
    m.Expression = @"AVERAGE(FactMSLPartnerUsage[TimeToAnswerSec])";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Time to Answer Sec -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Total Time Saved Hours") ? mt.Measures[@"Total Time Saved Hours"] : mt.AddMeasure(@"Total Time Saved Hours");
    m.Expression = @"DIVIDE(SUM(FactMSLPartnerUsage[TimeSavedMinutes]), 60, 0)";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Total Time Saved Hours -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Time Saved Per Query Min") ? mt.Measures[@"Avg Time Saved Per Query Min"] : mt.AddMeasure(@"Avg Time Saved Per Query Min");
    m.Expression = @"AVERAGE(FactMSLPartnerUsage[TimeSavedMinutes])";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Time Saved Per Query Min -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Used in HCP Interaction Rate") ? mt.Measures[@"Used in HCP Interaction Rate"] : mt.AddMeasure(@"Used in HCP Interaction Rate");
    m.Expression = @"DIVIDE(CALCULATE(COUNTROWS(FactMSLPartnerUsage), FactMSLPartnerUsage[UsedInHCPInteraction] = 1), [Total MSL Queries], 0)";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Used in HCP Interaction Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg MSL Satisfaction") ? mt.Measures[@"Avg MSL Satisfaction"] : mt.AddMeasure(@"Avg MSL Satisfaction");
    m.Expression = @"AVERAGE(FactMSLPartnerUsage[UserSatisfaction])";
    m.DisplayFolder = @"MSL Partner Usage";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg MSL Satisfaction -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Total Experiments") ? mt.Measures[@"Total Experiments"] : mt.AddMeasure(@"Total Experiments");
    m.Expression = @"COUNTROWS(DimExperiment)";
    m.DisplayFolder = @"Experiment Tracking";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Total Experiments -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Concluded Experiments") ? mt.Measures[@"Concluded Experiments"] : mt.AddMeasure(@"Concluded Experiments");
    m.Expression = @"CALCULATE(COUNTROWS(DimExperiment), LEFT(DimExperiment[Status], 9) = ""Concluded"")";
    m.DisplayFolder = @"Experiment Tracking";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Concluded Experiments -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Running Experiments") ? mt.Measures[@"Running Experiments"] : mt.AddMeasure(@"Running Experiments");
    m.Expression = @"CALCULATE(COUNTROWS(DimExperiment), DimExperiment[Status] = ""Running"")";
    m.DisplayFolder = @"Experiment Tracking";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Running Experiments -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Win Rate") ? mt.Measures[@"Win Rate"] : mt.AddMeasure(@"Win Rate");
    m.Expression = @"DIVIDE(CALCULATE(COUNTROWS(DimExperiment), DimExperiment[Status] = ""Concluded - Winner""), [Concluded Experiments], 0)";
    m.DisplayFolder = @"Experiment Tracking";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Win Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Observed Lift") ? mt.Measures[@"Avg Observed Lift"] : mt.AddMeasure(@"Avg Observed Lift");
    m.Expression = @"CALCULATE(AVERAGE(DimExperiment[ObservedLift]), DimExperiment[Status] = ""Concluded - Winner"")";
    m.DisplayFolder = @"Experiment Tracking";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Observed Lift -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Experiment Lift") ? mt.Measures[@"Experiment Lift"] : mt.AddMeasure(@"Experiment Lift");
    m.Expression = @"AVERAGE(DimExperiment[ObservedLift])";
    m.DisplayFolder = @"Experiment Tracking";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Experiment Lift -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Total Revenue USD") ? mt.Measures[@"Total Revenue USD"] : mt.AddMeasure(@"Total Revenue USD");
    m.Expression = @"SUM(FactFinancials[TotalRevenue_USD])";
    m.DisplayFolder = @"Financials";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Total Revenue USD -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Total Cost EUR") ? mt.Measures[@"Total Cost EUR"] : mt.AddMeasure(@"Total Cost EUR");
    m.Expression = @"SUM(FactFinancials[TotalCost_EUR])";
    m.DisplayFolder = @"Financials";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Total Cost EUR -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Gross Margin USD") ? mt.Measures[@"Gross Margin USD"] : mt.AddMeasure(@"Gross Margin USD");
    m.Expression = @"SUM(FactFinancials[GrossMargin_USD])";
    m.DisplayFolder = @"Financials";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Gross Margin USD -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Gross Margin Pct") ? mt.Measures[@"Gross Margin Pct"] : mt.AddMeasure(@"Gross Margin Pct");
    m.Expression = @"DIVIDE([Gross Margin USD], [Total Revenue USD], 0)";
    m.DisplayFolder = @"Financials";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Gross Margin Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Cost Per Call") ? mt.Measures[@"Avg Cost Per Call"] : mt.AddMeasure(@"Avg Cost Per Call");
    m.Expression = @"AVERAGE(FactFinancials[CostPerCall_EUR])";
    m.DisplayFolder = @"Financials";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Cost Per Call -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Cost Per Case") ? mt.Measures[@"Avg Cost Per Case"] : mt.AddMeasure(@"Avg Cost Per Case");
    m.Expression = @"AVERAGE(FactFinancials[CostPerCase_EUR])";
    m.DisplayFolder = @"Financials";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Cost Per Case -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Cost Breakdown Rep Pct") ? mt.Measures[@"Cost Breakdown Rep Pct"] : mt.AddMeasure(@"Cost Breakdown Rep Pct");
    m.Expression = @"DIVIDE(SUM(FactFinancials[RepCost_EUR]), [Total Cost EUR], 0)";
    m.DisplayFolder = @"Financials";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Cost Breakdown Rep Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Calls L4W") ? mt.Measures[@"Calls L4W"] : mt.AddMeasure(@"Calls L4W");
    m.Expression = @"CALCULATE([Total Calls], DATESINPERIOD(DimCalendar[Date], MAX(DimCalendar[Date]), -28, DAY))";
    m.DisplayFolder = @"Time Intelligence";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Calls L4W -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Connect Rate L4W") ? mt.Measures[@"Connect Rate L4W"] : mt.AddMeasure(@"Connect Rate L4W");
    m.Expression = @"CALCULATE([Connect Rate], DATESINPERIOD(DimCalendar[Date], MAX(DimCalendar[Date]), -28, DAY))";
    m.DisplayFolder = @"Time Intelligence";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Connect Rate L4W -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Calls MoM Change") ? mt.Measures[@"Calls MoM Change"] : mt.AddMeasure(@"Calls MoM Change");
    m.Expression = @"VAR Current = [Total Calls] VAR Prior = CALCULATE([Total Calls], DATEADD(DimCalendar[Date], -1, MONTH)) RETURN DIVIDE(Current - Prior, Prior, 0)";
    m.DisplayFolder = @"Time Intelligence";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Calls MoM Change -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Connect Rate MoM Change") ? mt.Measures[@"Connect Rate MoM Change"] : mt.AddMeasure(@"Connect Rate MoM Change");
    m.Expression = @"[Connect Rate] - CALCULATE([Connect Rate], DATEADD(DimCalendar[Date], -1, MONTH))";
    m.DisplayFolder = @"Time Intelligence";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Connect Rate MoM Change -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Abandonment Rate MoM Change") ? mt.Measures[@"Abandonment Rate MoM Change"] : mt.AddMeasure(@"Abandonment Rate MoM Change");
    m.Expression = @"[Abandonment Rate] - CALCULATE([Abandonment Rate], DATEADD(DimCalendar[Date], -1, MONTH))";
    m.DisplayFolder = @"Time Intelligence";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Abandonment Rate MoM Change -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Script Deviation Rate") ? mt.Measures[@"Script Deviation Rate"] : mt.AddMeasure(@"Script Deviation Rate");
    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[ScriptDeviation] = 1), [Connected Calls], 0)";
    m.DisplayFolder = @"Compliance & Quality";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Script Deviation Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Avg Call Quality Score") ? mt.Measures[@"Avg Call Quality Score"] : mt.AddMeasure(@"Avg Call Quality Score");
    m.Expression = @"CALCULATE(AVERAGE(FactHCPCalls[CallQualityScore]), NOT(ISBLANK(FactHCPCalls[CallQualityScore])))";
    m.DisplayFolder = @"Compliance & Quality";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Avg Call Quality Score -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"AE Flag Rate") ? mt.Measures[@"AE Flag Rate"] : mt.AddMeasure(@"AE Flag Rate");
    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[AdverseEventFlagged] = 1), [Connected Calls], 0)";
    m.DisplayFolder = @"Compliance & Quality";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: AE Flag Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"High Quality Calls Pct") ? mt.Measures[@"High Quality Calls Pct"] : mt.AddMeasure(@"High Quality Calls Pct");
    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[CallQualityScore] >= 7), CALCULATE([Total Calls], NOT(ISBLANK(FactHCPCalls[CallQualityScore]))), 0)";
    m.DisplayFolder = @"Compliance & Quality";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: High Quality Calls Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Low Quality Calls Pct") ? mt.Measures[@"Low Quality Calls Pct"] : mt.AddMeasure(@"Low Quality Calls Pct");
    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[CallQualityScore] <= 4), CALCULATE([Total Calls], NOT(ISBLANK(FactHCPCalls[CallQualityScore]))), 0)";
    m.DisplayFolder = @"Compliance & Quality";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Low Quality Calls Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Quality Adjusted Productivity") ? mt.Measures[@"Quality Adjusted Productivity"] : mt.AddMeasure(@"Quality Adjusted Productivity");
    m.Expression = @"[Meaningful Per Rep Per Day] * [Avg Call Quality Score] / 10";
    m.DisplayFolder = @"Workforce Efficiency";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Quality Adjusted Productivity -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Utilization Rate") ? mt.Measures[@"Utilization Rate"] : mt.AddMeasure(@"Utilization Rate");
    m.Expression = @"DIVIDE([Total Calls] * [Avg AHT], DISTINCTCOUNT(FactHCPCalls[RepID]) * DISTINCTCOUNT(FactHCPCalls[CallDate]) * 480, 0)";
    m.DisplayFolder = @"Workforce Efficiency";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Utilization Rate -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Calls Per Productive Hour") ? mt.Measures[@"Calls Per Productive Hour"] : mt.AddMeasure(@"Calls Per Productive Hour");
    m.Expression = @"DIVIDE([Total Calls], [Total Calls] * [Avg AHT] / 60, 0)";
    m.DisplayFolder = @"Workforce Efficiency";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Calls Per Productive Hour -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Deviation Rate by Tenure") ? mt.Measures[@"Deviation Rate by Tenure"] : mt.AddMeasure(@"Deviation Rate by Tenure");
    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[ScriptDeviation] = 1), [Total Calls], 0)";
