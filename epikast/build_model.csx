    mAdded++;
} catch (Exception ex) { Info("Measure failed: MSL Answer Quality RAG -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Script Deviation RAG") ? mt.Measures[@"Script Deviation RAG"] : mt.AddMeasure(@"Script Deviation RAG");
