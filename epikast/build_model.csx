    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Channel] = ""Phone"", FactHCPCalls[IsConnected] = 1), CALCULATE([Total Calls], FactHCPCalls[Channel] = ""Phone""), 0)";
    m.DisplayFolder = @"Channel Mix";
    mAdded++;
} catch (Exception ex) { Info("Measure failed: Connect Rate by Channel Phone -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Connect Rate RAG") ? mt.Measures[@"Connect Rate RAG"] : mt.AddMeasure(@"Connect Rate RAG");
    m.Expression = @"SWITCH(TRUE(), [Connect Rate] >= 0.35, ""Green"", [Connect Rate] >= 0.25, ""Amber"", ""Red"")";
