} catch (Exception ex) { Info("Measure failed: Email Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Video Pct") ? mt.Measures[@"Video Pct"] : mt.AddMeasure(@"Video Pct");
    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Channel] = ""Video""), [Total Calls], 0)";
    m.DisplayFolder = @"Channel Mix";
