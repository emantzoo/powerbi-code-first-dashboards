} catch (Exception ex) { Info("Measure failed: Phone Calls Pct -> " + ex.Message); }
try {
    var m = mt.Measures.Contains(@"Email Pct") ? mt.Measures[@"Email Pct"] : mt.AddMeasure(@"Email Pct");
    m.Expression = @"DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Channel] = ""Email""), [Total Calls], 0)";
    m.DisplayFolder = @"Channel Mix";
