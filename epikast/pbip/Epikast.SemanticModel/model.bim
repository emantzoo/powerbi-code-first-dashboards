          {
            "name": "CallTimeBucket",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR h = VALUE(LEFT(FactHCPCalls[CallTime], 2))\nRETURN SWITCH(TRUE(), h < 18, \"16-18\", h < 20, \"18-20\", h < 22, \"20-22\", \"22-00\")",
            "summarizeBy": "none",
            "lineageTag": "3e6e5bb8-477c-763f-3e28-2f4e50c479c0"
          },
          {
            "name": "SentimentBand",
            "dataType": "string",
            "type": "calculated",
            "expression": "SWITCH(TRUE(),\n    ISBLANK(FactHCPCalls[HCPSentimentScore]), BLANK(),\n    FactHCPCalls[HCPSentimentScore] >= 4, \"Positive\",\n    FactHCPCalls[HCPSentimentScore] >= 2.5, \"Neutral\",\n    \"Negative\")",
            "summarizeBy": "none",
            "lineageTag": "de70ba7d-bdf3-13cc-a073-7deaa83ec898"
          }
        ],
