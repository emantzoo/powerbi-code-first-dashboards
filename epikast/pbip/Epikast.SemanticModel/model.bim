          },
          {
            "name": "Calls MoM Change",
            "expression": "VAR Current = [Total Calls] VAR Prior = CALCULATE([Total Calls], DATEADD(DimCalendar[Date], -1, MONTH)) RETURN DIVIDE(Current - Prior, Prior, 0)",
            "displayFolder": "Time Intelligence",
            "lineageTag": "9e2eb483-db94-2f16-10bc-db96e2e16989"
          },
          {
            "name": "Connect Rate MoM Change",
            "expression": "[Connect Rate] - CALCULATE([Connect Rate], DATEADD(DimCalendar[Date], -1, MONTH))",
            "displayFolder": "Time Intelligence",
            "lineageTag": "db3ab6bd-8f88-c68f-fb7a-c578218e5c69"
          },
          {
            "name": "Abandonment Rate MoM Change",
            "expression": "[Abandonment Rate] - CALCULATE([Abandonment Rate], DATEADD(DimCalendar[Date], -1, MONTH))",
            "displayFolder": "Time Intelligence",
            "lineageTag": "170530eb-c7c8-7f4c-aab4-7b56498ccdc0"
          },
          {
            "name": "Script Deviation Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[ScriptDeviation] = 1), [Connected Calls], 0)",
            "displayFolder": "Compliance & Quality",
            "lineageTag": "2751c437-5af2-ff98-5fae-ba01df2dec0c"
          },
          {
            "name": "Avg Call Quality Score",
            "expression": "CALCULATE(AVERAGE(FactHCPCalls[CallQualityScore]), NOT(ISBLANK(FactHCPCalls[CallQualityScore])))",
            "displayFolder": "Compliance & Quality",
            "lineageTag": "a1fadf93-6358-3bd0-da1a-35a8641ec975"
          },
          {
            "name": "AE Flag Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[AdverseEventFlagged] = 1), [Connected Calls], 0)",
            "displayFolder": "Compliance & Quality",
            "lineageTag": "c52bc21f-f2f9-15d7-2e3b-9f4b38da701b"
          },
          {
            "name": "High Quality Calls Pct",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[CallQualityScore] >= 7), CALCULATE([Total Calls], NOT(ISBLANK(FactHCPCalls[CallQualityScore]))), 0)",
            "displayFolder": "Compliance & Quality",
            "lineageTag": "899b94d9-55b2-13f8-353d-e309d444f98c"
          },
          {
            "name": "Low Quality Calls Pct",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[CallQualityScore] <= 4), CALCULATE([Total Calls], NOT(ISBLANK(FactHCPCalls[CallQualityScore]))), 0)",
            "displayFolder": "Compliance & Quality",
            "lineageTag": "df3ffa41-df40-9002-8465-4559a2bd8a3e"
          },
          {
            "name": "Quality Adjusted Productivity",
            "expression": "[Meaningful Per Rep Per Day] * [Avg Call Quality Score] / 10",
            "displayFolder": "Workforce Efficiency",
            "lineageTag": "e67be570-4fdc-c646-83af-3dd7cdee8dfe"
          },
          {
            "name": "Utilization Rate",
            "expression": "DIVIDE([Total Calls] * [Avg AHT], DISTINCTCOUNT(FactHCPCalls[RepID]) * DISTINCTCOUNT(FactHCPCalls[CallDate]) * 480, 0)",
            "displayFolder": "Workforce Efficiency",
            "lineageTag": "3785253b-79dc-0d86-0b5e-fa508eb7a10d"
          },
          {
            "name": "Calls Per Productive Hour",
            "expression": "DIVIDE([Total Calls], [Total Calls] * [Avg AHT] / 60, 0)",
            "displayFolder": "Workforce Efficiency",
            "lineageTag": "a215ce8d-d336-958a-7d76-d57f5d3f2867"
          },
          {
            "name": "Deviation Rate by Tenure",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[ScriptDeviation] = 1), [Total Calls], 0)",
            "displayFolder": "Workforce Efficiency",
            "lineageTag": "78ed7da0-2bac-5970-a6f4-326ffd554d30"
          },
          {
            "name": "Phone Calls Pct",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Channel] = \"Phone\"), [Total Calls], 0)",
            "displayFolder": "Channel Mix",
            "lineageTag": "74cb4e7c-a981-3267-a7b9-a2c7d752cc62"
          },
          {
            "name": "Email Pct",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Channel] = \"Email\"), [Total Calls], 0)",
            "displayFolder": "Channel Mix",
            "lineageTag": "54dacca4-1804-0d7f-c1fd-1a74b328d834"
          },
          {
            "name": "Video Pct",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Channel] = \"Video\"), [Total Calls], 0)",
            "displayFolder": "Channel Mix",
            "lineageTag": "8f42dd0c-72e9-8d0a-4086-63d85a89ca4f"
          },
          {
            "name": "Connect Rate by Channel Phone",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Channel] = \"Phone\", FactHCPCalls[IsConnected] = 1), CALCULATE([Total Calls], FactHCPCalls[Channel] = \"Phone\"), 0)",
            "displayFolder": "Channel Mix",
            "lineageTag": "4283925e-3ae7-bd94-e36e-fe36ba4c1495"
          },
          {
            "name": "Connect Rate RAG",
            "expression": "SWITCH(TRUE(), [Connect Rate] >= 0.35, \"Green\", [Connect Rate] >= 0.25, \"Amber\", \"Red\")",
            "displayFolder": "RAG Indicators",
            "lineageTag": "0b308148-ff02-3342-1970-9dc328896192"
          },
          {
            "name": "Abandonment Rate RAG",
            "expression": "SWITCH(TRUE(), [Abandonment Rate] <= 0.15, \"Green\", [Abandonment Rate] <= 0.25, \"Amber\", \"Red\")",
            "displayFolder": "RAG Indicators",
            "lineageTag": "91111af5-c354-2d0b-55b0-1deda221b4df"
          },
          {
            "name": "Time to Therapy RAG",
            "expression": "SWITCH(TRUE(), [Avg Time to Therapy] <= 20, \"Green\", [Avg Time to Therapy] <= 35, \"Amber\", \"Red\")",
            "displayFolder": "RAG Indicators",
            "lineageTag": "b2885eb0-9f9a-28df-0a90-bdcb0c81a7c9"
          },
          {
            "name": "PA Approval Rate RAG",
            "expression": "SWITCH(TRUE(), [PA Approval Rate] >= 0.70, \"Green\", [PA Approval Rate] >= 0.55, \"Amber\", \"Red\")",
            "displayFolder": "RAG Indicators",
            "lineageTag": "b71c91ed-f883-de84-7cf5-b409f5070791"
          },
          {
            "name": "Schedule Adherence RAG",
            "expression": "SWITCH(TRUE(), [Schedule Adherence Rate] >= 0.85, \"Green\", [Schedule Adherence Rate] >= 0.75, \"Amber\", \"Red\")",
            "displayFolder": "RAG Indicators",
            "lineageTag": "2f37816a-bf3c-feed-7e03-6918944195ff"
          },
          {
            "name": "MSL Answer Quality RAG",
            "expression": "SWITCH(TRUE(), [Fully Answered Rate] >= 0.70, \"Green\", [Fully Answered Rate] >= 0.55, \"Amber\", \"Red\")",
            "displayFolder": "RAG Indicators",
            "lineageTag": "3c8487b1-3494-e0a1-7d59-2a73671ad834"
          },
          {
            "name": "Script Deviation RAG",
            "expression": "SWITCH(TRUE(), [Script Deviation Rate] <= 0.05, \"Green\", [Script Deviation Rate] <= 0.15, \"Amber\", \"Red\")",
            "displayFolder": "RAG Indicators",
            "lineageTag": "be12ac3a-ca4e-2db2-3d29-e4e9711e0bfe"
          },
          {
            "name": "Avg Days Rx to Contact",
            "expression": "CALCULATE(AVERAGEX(FactPatientCases, DATEDIFF(FactPatientCases[RxDate], FactPatientCases[FirstContactDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Access Bottleneck",
            "lineageTag": "cc92789f-d313-304f-4dd6-52a502cc821d"
          },
          {
            "name": "Avg Days Contact to PA Submit",
            "expression": "CALCULATE(AVERAGEX(FactPatientCases, DATEDIFF(FactPatientCases[FirstContactDate], FactPatientCases[PASubmitDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Access Bottleneck",
            "lineageTag": "bdf2dbfd-b31b-23db-1848-e5f829a3ca02"
          },
          {
            "name": "Avg Days PA Submit to Decision",
            "expression": "CALCULATE(AVERAGEX(FILTER(FactPatientCases, NOT(ISBLANK(FactPatientCases[PADecisionDate]))), DATEDIFF(FactPatientCases[PASubmitDate], FactPatientCases[PADecisionDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Access Bottleneck",
            "lineageTag": "919b5f59-fd12-a342-0c1e-044f6f73990d"
          },
          {
            "name": "Avg Days Decision to Fulfillment",
            "expression": "CALCULATE(AVERAGEX(FILTER(FactPatientCases, NOT(ISBLANK(FactPatientCases[FulfillmentDate]))), DATEDIFF(FactPatientCases[PADecisionDate], FactPatientCases[FulfillmentDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Access Bottleneck",
            "lineageTag": "b683d536-06d0-5314-25ea-40bbca8e586f"
          },
          {
            "name": "Avg Days Fulfillment to First Dose",
            "expression": "CALCULATE(AVERAGEX(FILTER(FactPatientCases, NOT(ISBLANK(FactPatientCases[FirstDoseDate]))), DATEDIFF(FactPatientCases[FulfillmentDate], FactPatientCases[FirstDoseDate], DAY)), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Access Bottleneck",
            "lineageTag": "08d43839-751e-ffcc-e135-e77ad1f424e0"
          },
          {
            "name": "Total Handling Minutes",
            "expression": "SUM(FactHCPCalls[AHT_Minutes])",
            "displayFolder": "Selling Time vs Admin",
            "lineageTag": "eb88c2db-a32f-4ba1-1f8b-d46ecbad759b"
          },
          {
            "name": "Selling Minutes",
            "expression": "CALCULATE(SUM(FactHCPCalls[DurationMinutes]), FactHCPCalls[IsConnected] = 1)",
            "displayFolder": "Selling Time vs Admin",
            "lineageTag": "b06b90e2-d588-6fea-df5a-07cc5483d56c"
          },
          {
            "name": "Selling Time Pct",
            "expression": "DIVIDE([Selling Minutes], [Total Handling Minutes], 0)",
            "displayFolder": "Selling Time vs Admin",
            "lineageTag": "4793f13d-fd8a-adb6-e515-81424d1e6ca0"
          },
          {
            "name": "Admin Time Pct",
            "expression": "DIVIDE(SUM(FactHCPCalls[AfterCallWorkMinutes]), [Total Handling Minutes], 0)",
            "displayFolder": "Selling Time vs Admin",
            "lineageTag": "bb44bd97-90d6-f942-e02f-7d60d739284a"
          },
          {
            "name": "Positive Sentiment Pct",
            "expression": "DIVIDE(\n    CALCULATE([Total Calls], FactHCPCalls[SentimentBand] = \"Positive\"),\n    CALCULATE([Total Calls], NOT(ISBLANK(FactHCPCalls[HCPSentimentScore]))), 0)",
            "displayFolder": "Sentiment & Insight Engine",
            "lineageTag": "e29ceb6f-7f16-bba1-371a-f1532e5d6d5b"
          },
          {
            "name": "Negative Sentiment Pct",
            "expression": "DIVIDE(\n    CALCULATE([Total Calls], FactHCPCalls[SentimentBand] = \"Negative\"),\n    CALCULATE([Total Calls], NOT(ISBLANK(FactHCPCalls[HCPSentimentScore]))), 0)",
            "displayFolder": "Sentiment & Insight Engine",
            "lineageTag": "0e434f09-2843-d691-3373-7b28054292d4"
          },
          {
            "name": "Avg Uplift",
            "expression": "AVERAGE(FactUplift[uplift])",
            "displayFolder": "Sentiment & Insight Engine",
            "lineageTag": "44834f23-0520-1c8c-56ef-d58b5f5554c0"
          },
          {
            "name": "Avg Importance",
            "expression": "AVERAGE(FeatureImportance[importance])",
            "displayFolder": "Sentiment & Insight Engine",
            "lineageTag": "9fecbae6-e370-24a3-d138-67261745c175"
          },
          {
            "name": "Avg Shap Importance",
            "expression": "AVERAGE(ShapImportance[mean_abs_shap])",
            "displayFolder": "Sentiment & Insight Engine",
            "lineageTag": "31cf3518-54e8-5257-7db2-ced07f38ac79"
          },
          {
            "name": "Last Data Date",
            "expression": "CALCULATE(MAX(FactHCPCalls[CallDate]), ALL(FactHCPCalls), ALL(DimCalendar))",
            "displayFolder": "Recent Activity \u2014 as-of latest data date",
            "lineageTag": "b68e9646-1f2f-879a-9bd0-e37c5c9687c5"
          },
          {
            "name": "Calls Last 7 Days",
            "expression": "CALCULATE([Total Calls], DATESINPERIOD(DimCalendar[Date], [Last Data Date], -7, DAY))",
            "displayFolder": "Recent Activity \u2014 as-of latest data date",
            "lineageTag": "970f4caa-013a-03ee-3f78-dbf9a369ed8e"
          },
          {
            "name": "Calls Prior 7 Days",
            "expression": "CALCULATE([Total Calls], DATESINPERIOD(DimCalendar[Date], [Last Data Date] - 7, -7, DAY))",
            "displayFolder": "Recent Activity \u2014 as-of latest data date",
            "lineageTag": "65b036a2-18e6-e583-f930-9b5963555b2e"
          },
          {
            "name": "Calls WoW Change",
            "expression": "DIVIDE([Calls Last 7 Days] - [Calls Prior 7 Days], [Calls Prior 7 Days], 0)",
            "displayFolder": "Recent Activity \u2014 as-of latest data date",
            "lineageTag": "6bdefb75-5a78-2072-9c59-57ff7f3874ec"
          },
          {
            "name": "Connect Rate Last 7 Days",
            "expression": "CALCULATE([Connect Rate], DATESINPERIOD(DimCalendar[Date], [Last Data Date], -7, DAY))",
            "displayFolder": "Recent Activity \u2014 as-of latest data date",
            "lineageTag": "95663c14-904e-20d7-20d8-071d328935dc"
          },
          {
            "name": "Cases First Contacted",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[FirstContactDate])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Funnel Stage Counts",
            "lineageTag": "f6169434-5e9c-e174-2951-dcb1eb12cd3f"
          },
          {
            "name": "Cases PA Submitted",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[PASubmitDate])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Funnel Stage Counts",
            "lineageTag": "8642f009-defc-a6ff-352e-f67131c7b659"
          },
          {
            "name": "Cases PA Approved",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[PAStatus] = \"Approved\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Funnel Stage Counts",
            "lineageTag": "a60ab2dc-75de-ffbf-4014-ca9bbb011c69"
          },
          {
            "name": "Cases Fulfilled",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[FulfillmentDate])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Funnel Stage Counts",
            "lineageTag": "88865394-53dd-95d2-39aa-fc6693664593"
          },
          {
            "name": "Cases On Therapy",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[FirstDoseDate])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Funnel Stage Counts",
            "lineageTag": "d78af7d7-ca61-bd18-d5d6-efb793024ccd"
          },
          {
            "name": "Open High Risk Cases",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[Open Case Age Bucket] = \"14d+\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Open-Case Aging",
            "lineageTag": "06e68b68-0bb4-3ef1-5fc3-45c6f93444e4"
          }
        ]
      }
    ],
