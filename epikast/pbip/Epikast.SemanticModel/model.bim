          {
            "name": "Open Case Age Bucket",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR AsOf = CALCULATE(MAX(FactHCPCalls[CallDate]), ALL(FactHCPCalls))\nVAR d = DATEDIFF(FactPatientCases[RxDate], AsOf, DAY)\nRETURN IF(NOT(FactPatientCases[CaseStatus] IN {\"Open\", \"In Progress\"}), BLANK(),\n    SWITCH(TRUE(), d < 3, \"<3d\", d < 7, \"3-7d\", d < 14, \"7-14d\", \"14d+\"))",
            "summarizeBy": "none",
            "lineageTag": "6f4e5eb4-c540-8caa-2d40-c37150dd920b"
          }
        ],
