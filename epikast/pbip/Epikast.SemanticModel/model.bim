            "name": "TenureMonths",
            "dataType": "int64",
            "sourceColumn": "TenureMonths",
            "summarizeBy": "none",
            "lineageTag": "fd84c151-e8af-0416-e9b7-42cdac7430d4",
            "formatString": "0"
          },
          {
            "name": "IsActive",
            "dataType": "int64",
            "sourceColumn": "IsActive",
            "summarizeBy": "none",
            "lineageTag": "2d36bb93-843d-3adf-bbb1-c77c04b23abf",
            "formatString": "0"
          },
          {
            "name": "Performance Tier",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR Total = COUNTROWS(ALL(DimRep))\nVAR Rnk = RANKX(ALL(DimRep), CALCULATE([Meaningful Interactions]), , DESC)\nRETURN IF(Rnk <= ROUNDUP(Total * 0.2, 0), \"Top 20%\", \"Rest\")",
            "summarizeBy": "none",
            "lineageTag": "c81b167b-1979-9d78-893e-8f13163ba3fb"
          },
          {
            "name": "Tenure Bucket",
            "dataType": "string",
            "type": "calculated",
            "expression": "SWITCH(TRUE(),\n    DimRep[TenureMonths] < 6, \"0-6mo\",\n    DimRep[TenureMonths] < 12, \"6-12mo\",\n    DimRep[TenureMonths] < 18, \"12-18mo\",\n    \"18+mo\")",
            "summarizeBy": "none",
            "lineageTag": "58c414dc-2e28-3a63-871d-3140654c9b12"
          },
          {
            "name": "AI Adoption Band",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR r = CALCULATE(DIVIDE(CALCULATE(COUNTROWS(FactHCPCalls), FactHCPCalls[AIFollowed] = 1), COUNTROWS(FactHCPCalls)))\nRETURN SWITCH(TRUE(), r >= 0.5, \"High\", r >= 0.3, \"Medium\", \"Low\")",
            "summarizeBy": "none",
            "lineageTag": "91a168b4-74af-8e4a-1a5e-39fb9224ff12"
          }
        ],
        "partitions": [
          {
