          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "{BLANK()}"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Calls",
            "expression": "COUNTROWS(FactHCPCalls)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "99a5b202-0734-7502-46f2-8755ed6b5bbe"
          },
          {
            "name": "Connected Calls",
            "expression": "CALCULATE([Total Calls], FactHCPCalls[IsConnected] = 1)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "a873c5d0-99e5-e7fa-2622-d3791551ee76"
          },
          {
            "name": "Connect Rate",
            "expression": "DIVIDE([Connected Calls], [Total Calls], 0)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "80c4f1df-cdf7-5eb6-a8fb-e0ad1bc659e9"
          },
          {
            "name": "Meaningful Interactions",
            "expression": "CALCULATE([Total Calls], FactHCPCalls[IsMeaningfulInteraction] = 1)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "3bb590a5-ba12-e469-521a-d6abe8ae4a54"
          },
          {
            "name": "Meaningful Interaction Rate",
            "expression": "DIVIDE([Meaningful Interactions], [Connected Calls], 0)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "eeb804d3-b270-25ef-f4f8-3e3072805781"
          },
          {
            "name": "HCPs Contacted",
            "expression": "DISTINCTCOUNT(FactHCPCalls[HCPID])",
            "displayFolder": "HCP Engagement",
            "lineageTag": "6564f271-46bb-312e-d822-0e18412e6c8c"
          },
          {
            "name": "Target HCPs",
            "expression": "CALCULATE(DISTINCTCOUNT(DimHCP[HCPID]), DimHCP[IsTarget] = 1)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "ca5a676d-3a0d-79b2-de22-bb1c2e822779"
          },
          {
            "name": "HCP Reach",
            "expression": "DIVIDE(CALCULATE(DISTINCTCOUNT(FactHCPCalls[HCPID]), FactHCPCalls[IsConnected] = 1), [Target HCPs], 0)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "684f3f1e-8df7-83d6-8b87-8072c9b71b56"
          },
          {
            "name": "Avg Contact Frequency",
            "expression": "DIVIDE([Connected Calls], [HCPs Contacted], 0)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "e5236410-e10d-f4d3-0a48-3391ca0b2e97"
          },
          {
            "name": "Avg Call Duration",
            "expression": "CALCULATE(AVERAGE(FactHCPCalls[DurationMinutes]), FactHCPCalls[IsConnected] = 1)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "6babb049-4c31-6bad-e0b2-bfd71186740b"
          },
          {
            "name": "Avg Meaningful Duration",
            "expression": "CALCULATE(AVERAGE(FactHCPCalls[DurationMinutes]), FactHCPCalls[IsMeaningfulInteraction] = 1)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "0fb8788c-6ace-07f2-8417-f65685a8c6ae"
          },
          {
            "name": "Follow Up Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[FollowUpScheduled] = 1), [Connected Calls], 0)",
            "displayFolder": "HCP Engagement",
            "lineageTag": "dd6c05cd-1aa7-4b7c-3499-43a6621709ab"
          },
          {
            "name": "Avg HCP Sentiment",
            "expression": "CALCULATE(AVERAGE(FactHCPCalls[HCPSentimentScore]), NOT(ISBLANK(FactHCPCalls[HCPSentimentScore])))",
            "displayFolder": "HCP Engagement",
            "lineageTag": "cdf390a1-c4b9-21cc-125f-dcd823d1f4cf"
          },
          {
            "name": "AI Recommended Calls",
            "expression": "CALCULATE([Total Calls], FactHCPCalls[AIRecommended] = 1)",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "8c33ab04-142e-ab59-85bd-ed5d5ae3e019"
          },
          {
            "name": "AI Followed Calls",
            "expression": "CALCULATE([Total Calls], FactHCPCalls[AIFollowed] = 1)",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "24e43a90-97e1-dfab-1b2a-a05f2fe71eb1"
          },
          {
            "name": "AI Acceptance Rate",
            "expression": "DIVIDE([AI Followed Calls], [AI Recommended Calls], 0)",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "0de8a975-f07d-296a-f96a-1ec69ea34d77"
          },
          {
            "name": "AI Connect Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[AIFollowed] = 1, FactHCPCalls[IsConnected] = 1), [AI Followed Calls], 0)",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "b43b7907-a263-aec2-6f94-fbb8c01cd867"
          },
          {
            "name": "Non-AI Connect Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[AIRecommended] = 0, FactHCPCalls[IsConnected] = 1), CALCULATE([Total Calls], FactHCPCalls[AIRecommended] = 0), 0)",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "95d586a5-8807-a31b-3906-5e19e4e68ba0"
          },
          {
            "name": "AI Lift on Connect Rate",
            "expression": "[AI Connect Rate] - [Non-AI Connect Rate]",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "17344745-05ab-cef1-2dc6-9866316eda15"
          },
          {
            "name": "AI Meaningful Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[AIFollowed] = 1, FactHCPCalls[IsMeaningfulInteraction] = 1), CALCULATE([Total Calls], FactHCPCalls[AIFollowed] = 1, FactHCPCalls[IsConnected] = 1), 0)",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "2f5e35bf-8e74-9ba9-7882-4263a184bdb7"
          },
          {
            "name": "Non-AI Meaningful Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[AIRecommended] = 0, FactHCPCalls[IsMeaningfulInteraction] = 1), CALCULATE([Total Calls], FactHCPCalls[AIRecommended] = 0, FactHCPCalls[IsConnected] = 1), 0)",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "b3bd9753-5fd4-2b44-6ef0-dda00fa630dd"
          },
          {
            "name": "AI Lift on Meaningful Rate",
            "expression": "[AI Meaningful Rate] - [Non-AI Meaningful Rate]",
            "displayFolder": "AI / Next-Best-Action",
            "lineageTag": "f864f6d0-f1d9-d587-e715-111940ed2384"
          },
          {
            "name": "Script A Calls",
            "expression": "CALCULATE([Total Calls], FactHCPCalls[Script] = \"Script A - Empathetic\")",
            "displayFolder": "Script A/B Testing",
            "lineageTag": "4fdd926d-df01-60a4-9589-c9defe3ebd51"
          },
          {
            "name": "Script B Calls",
            "expression": "CALCULATE([Total Calls], FactHCPCalls[Script] = \"Script B - Direct\")",
            "displayFolder": "Script A/B Testing",
            "lineageTag": "6f039bbf-6719-bc33-8bc9-1be927e161db"
          },
          {
            "name": "Script A Connect Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Script] = \"Script A - Empathetic\", FactHCPCalls[IsConnected] = 1), [Script A Calls], 0)",
            "displayFolder": "Script A/B Testing",
            "lineageTag": "a76d3d96-10b9-42a4-075c-80aa259af930"
          },
          {
            "name": "Script B Connect Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Script] = \"Script B - Direct\", FactHCPCalls[IsConnected] = 1), [Script B Calls], 0)",
            "displayFolder": "Script A/B Testing",
            "lineageTag": "d8997c43-2d11-33fe-d94c-29dc2a0ba182"
          },
          {
            "name": "Script A Meaningful Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Script] = \"Script A - Empathetic\", FactHCPCalls[IsMeaningfulInteraction] = 1), CALCULATE([Total Calls], FactHCPCalls[Script] = \"Script A - Empathetic\", FactHCPCalls[IsConnected] = 1), 0)",
            "displayFolder": "Script A/B Testing",
            "lineageTag": "95f11d99-e8eb-12b7-c43b-2e437deee2a1"
          },
          {
            "name": "Script B Meaningful Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[Script] = \"Script B - Direct\", FactHCPCalls[IsMeaningfulInteraction] = 1), CALCULATE([Total Calls], FactHCPCalls[Script] = \"Script B - Direct\", FactHCPCalls[IsConnected] = 1), 0)",
            "displayFolder": "Script A/B Testing",
            "lineageTag": "12b94158-885b-af00-b784-3e5a3d57791a"
          },
          {
            "name": "Script A Avg Duration",
            "expression": "CALCULATE(AVERAGE(FactHCPCalls[DurationMinutes]), FactHCPCalls[Script] = \"Script A - Empathetic\", FactHCPCalls[IsConnected] = 1)",
            "displayFolder": "Script A/B Testing",
            "lineageTag": "1b165220-1934-1ced-3e96-0145ff1c96dd"
          },
          {
            "name": "Script B Avg Duration",
            "expression": "CALCULATE(AVERAGE(FactHCPCalls[DurationMinutes]), FactHCPCalls[Script] = \"Script B - Direct\", FactHCPCalls[IsConnected] = 1)",
            "displayFolder": "Script A/B Testing",
            "lineageTag": "bf471ecc-f3a9-7443-339d-3860b0c6a2c5"
          },
          {
            "name": "Total Cases",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "10fa2687-5475-d608-c43c-cce479640ef5"
          },
          {
            "name": "Active Cases",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[CaseStatus] IN {\"Open\", \"In Progress\"}, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "2ae64ee0-133c-6241-20c6-adf6fa54eff8"
          },
          {
            "name": "Resolved Cases",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[CaseStatus] = \"Resolved\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "cef383c5-9eb7-c42b-fb73-4c999532d0d9"
          },
          {
            "name": "Abandoned Cases",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[IsAbandoned] = 1, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "b2d032e0-64a6-5b6a-65b6-5e2d1c18e496"
          },
          {
            "name": "Abandonment Rate",
            "expression": "DIVIDE([Abandoned Cases], [Total Cases], 0)",
            "displayFolder": "Patient Support",
            "lineageTag": "49050b6f-3ba5-bf94-20fe-1cb6f763dc2b"
          },
          {
            "name": "Avg Time to Therapy",
            "expression": "CALCULATE(AVERAGE(FactPatientCases[TimeToTherapyDays]), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "e2699565-2c45-52f8-0dd6-427e9c466a1e"
          },
          {
            "name": "Median Time to Therapy",
            "expression": "CALCULATE(MEDIAN(FactPatientCases[TimeToTherapyDays]), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "154e9ece-5434-b184-ad82-934470e0e4ad"
          },
          {
            "name": "PA Approval Rate",
            "expression": "DIVIDE(\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[PAStatus] = \"Approved\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])),\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[PAStatus] IN {\"Approved\", \"Denied\", \"Appeal\"}, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])), 0)",
            "displayFolder": "Patient Support",
            "lineageTag": "ca7bf889-4c63-1ec2-5183-1d5b5ee26ee1"
          },
          {
            "name": "PA Denial Rate",
            "expression": "DIVIDE(\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[PAStatus] = \"Denied\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])),\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[PAStatus] IN {\"Approved\", \"Denied\", \"Appeal\"}, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])), 0)",
            "displayFolder": "Patient Support",
            "lineageTag": "6cfa093a-9ba4-f206-b3b9-8d55d4969102"
          },
          {
            "name": "Avg PA Decision Delay",
            "expression": "CALCULATE(AVERAGE(FactPatientCases[PADecisionDelayDays]), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "c99f45a0-cd50-3577-f6ca-33faf2f62326"
          },
          {
            "name": "First Call Resolution Rate",
            "expression": "DIVIDE(\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[FirstCallResolved] = 1, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])),\n    [Resolved Cases], 0)",
            "displayFolder": "Patient Support",
            "lineageTag": "b997b1ea-830f-0ac2-d97e-8116b99aaa49"
          },
          {
            "name": "Avg Case Resolution Days",
            "expression": "CALCULATE(AVERAGE(FactPatientCases[CaseResolutionDays]), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "03d9f1a6-a029-aa54-e088-ec2eb1b061b2"
          },
          {
            "name": "Avg First Contact Delay",
            "expression": "CALCULATE(AVERAGE(FactPatientCases[FirstContactDelayDays]), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "8a0f7dfc-d8af-eba2-5896-62d067eca6d6"
          },
          {
            "name": "Contacted Within 48h Rate",
            "expression": "DIVIDE(\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[FirstContactDelayDays] <= 2, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])),\n    [Total Cases], 0)",
            "displayFolder": "Patient Support",
            "lineageTag": "cd330ee2-0eb6-04c0-4626-9c8a996017aa"
          },
          {
            "name": "Adherence 30 Day",
            "expression": "DIVIDE(\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[Adherent30] = 1, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])),\n    CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[Adherent30])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])), 0)",
            "displayFolder": "Patient Support",
            "lineageTag": "9d1a9eb1-0804-abdd-a165-901ae9ede855"
          },
          {
            "name": "Adherence 60 Day",
            "expression": "DIVIDE(\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[Adherent60] = 1, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])),\n    CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[Adherent60])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])), 0)",
            "displayFolder": "Patient Support",
            "lineageTag": "4c733db2-67ff-3d66-d5c4-b598bb65a469"
          },
          {
            "name": "Adherence 90 Day",
            "expression": "DIVIDE(\n    CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[Adherent90] = 1, USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])),\n    CALCULATE(COUNTROWS(FactPatientCases), NOT(ISBLANK(FactPatientCases[Adherent90])), USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date])), 0)",
            "displayFolder": "Patient Support",
            "lineageTag": "de7ace23-bc3b-52e2-31b3-67abdab8328a"
          },
          {
            "name": "Abandoned Pre PA",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[IsAbandoned] = 1, FactPatientCases[AbandonmentStage] = \"Pre-PA\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "220ef8a5-ce43-554c-a0d2-cba888cb31ed"
          },
          {
            "name": "Abandoned During PA",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[IsAbandoned] = 1, FactPatientCases[AbandonmentStage] = \"During PA\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "3336c62d-9f89-5d10-acfe-b1c94805f6f0"
          },
          {
            "name": "Abandoned Post PA",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[IsAbandoned] = 1, FactPatientCases[AbandonmentStage] = \"Post-PA\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "bef6b0fe-f9f9-fb86-455a-078f3cee4cd8"
          },
          {
            "name": "Abandoned Post Fulfillment",
            "expression": "CALCULATE(COUNTROWS(FactPatientCases), FactPatientCases[IsAbandoned] = 1, FactPatientCases[AbandonmentStage] = \"Post-Fulfillment\", USERELATIONSHIP(FactPatientCases[RxDate], DimCalendar[Date]))",
            "displayFolder": "Patient Support",
            "lineageTag": "8ea2a73f-1821-eddc-94b7-a2b9f5ae7cac"
          },
          {
            "name": "Avg AHT",
            "expression": "AVERAGE(FactHCPCalls[AHT_Minutes])",
            "displayFolder": "Ops Efficiency",
            "lineageTag": "f3385028-e73e-ffa3-1b7b-9ab97b6b3c98"
          },
          {
            "name": "Avg After Call Work",
            "expression": "AVERAGE(FactHCPCalls[AfterCallWorkMinutes])",
            "displayFolder": "Ops Efficiency",
            "lineageTag": "afa9bf42-6d47-e116-418a-0ddb0b0a67bf"
          },
          {
            "name": "Schedule Adherence Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[IsScheduleAdherent] = 1), [Total Calls], 0)",
            "displayFolder": "Ops Efficiency",
            "lineageTag": "8210e520-521a-cb73-8a51-d9ca23cddc65"
          },
          {
            "name": "Calls Per Rep Per Day",
            "expression": "DIVIDE([Total Calls], DISTINCTCOUNT(FactHCPCalls[RepID]) * DISTINCTCOUNT(FactHCPCalls[CallDate]), 0)",
            "displayFolder": "Ops Efficiency",
            "lineageTag": "0cba3eb6-211d-a39c-56fe-77593d476e6d"
          },
          {
            "name": "Connected Calls Per Rep Per Day",
            "expression": "DIVIDE([Connected Calls], DISTINCTCOUNT(FactHCPCalls[RepID]) * DISTINCTCOUNT(FactHCPCalls[CallDate]), 0)",
            "displayFolder": "Ops Efficiency",
            "lineageTag": "319112da-4582-42df-d467-59fcded98d66"
          },
          {
            "name": "Meaningful Per Rep Per Day",
            "expression": "DIVIDE([Meaningful Interactions], DISTINCTCOUNT(FactHCPCalls[RepID]) * DISTINCTCOUNT(FactHCPCalls[CallDate]), 0)",
            "displayFolder": "Ops Efficiency",
            "lineageTag": "97f1e588-404e-b8be-357a-d3d87ab50854"
          },
          {
            "name": "Notes Compliance Rate",
            "expression": "DIVIDE(CALCULATE([Total Calls], FactHCPCalls[NotesTaken] = 1), [Connected Calls], 0)",
            "displayFolder": "Ops Efficiency",
            "lineageTag": "4ba3fcee-8743-4ff8-9180-dd3a572a01c0"
          },
          {
            "name": "Total Rx",
            "expression": "CALCULATE(COUNTROWS(FactRx), USERELATIONSHIP(FactRx[RxDate], DimCalendar[Date]))",
            "displayFolder": "Prescriptions",
            "lineageTag": "a9b63c25-0cac-2997-6dbd-94c0f6d9faf8"
          },
          {
            "name": "New to Brand Rx",
            "expression": "CALCULATE(COUNTROWS(FactRx), FactRx[IsNewToBrand] = 1, USERELATIONSHIP(FactRx[RxDate], DimCalendar[Date]))",
            "displayFolder": "Prescriptions",
            "lineageTag": "1da497ee-e549-036f-ab8a-98f6eed80a02"
          },
          {
            "name": "NBRx Rate",
            "expression": "DIVIDE([New to Brand Rx], [Total Rx], 0)",
            "displayFolder": "Prescriptions",
            "lineageTag": "0f77b4e7-5272-27ca-8717-39bda7dbba8c"
          },
          {
            "name": "Rx Per HCP",
            "expression": "DIVIDE([Total Rx], DISTINCTCOUNT(FactRx[HCPID]), 0)\nRx from Engaged HCPs =",
            "displayFolder": "Prescriptions",
            "lineageTag": "add13509-b8c0-0807-9d55-1927e0c2a27d"
          },
          {
            "name": "VAR EngagedHCPs",
            "expression": "CALCULATETABLE(VALUES(FactHCPCalls[HCPID]), FactHCPCalls[IsConnected] = 1)\nRETURN CALCULATE(COUNTROWS(FactRx), USERELATIONSHIP(FactRx[RxDate], DimCalendar[Date]), TREATAS(EngagedHCPs, FactRx[HCPID]))",
            "displayFolder": "Prescriptions",
            "lineageTag": "a8cd1695-70c4-e617-329d-f2b1b51b30a5"
          },
          {
            "name": "Rx from Non-Engaged HCPs",
            "expression": "[Total Rx] - [Rx from Engaged HCPs]\nNBRx from Engaged HCPs =",
            "displayFolder": "Prescriptions",
            "lineageTag": "a7f970da-f01a-fc8e-b58f-c20b13c8a837"
          },
          {
            "name": "VAR EngagedHCPs",
            "expression": "CALCULATETABLE(VALUES(FactHCPCalls[HCPID]), FactHCPCalls[IsConnected] = 1)\nRETURN CALCULATE(COUNTROWS(FactRx), FactRx[IsNewToBrand] = 1, USERELATIONSHIP(FactRx[RxDate], DimCalendar[Date]), TREATAS(EngagedHCPs, FactRx[HCPID]))",
            "displayFolder": "Prescriptions",
            "lineageTag": "a8cd1695-70c4-e617-329d-f2b1b51b30a5"
          },
          {
            "name": "Total MSL Queries",
            "expression": "CALCULATE(COUNTROWS(FactMSLPartnerUsage), USERELATIONSHIP(FactMSLPartnerUsage[UsageDate], DimCalendar[Date]))",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "f2630ed4-d728-8f02-7182-3606052fee66"
          },
          {
            "name": "MSL Queries Per Day",
            "expression": "DIVIDE([Total MSL Queries], DISTINCTCOUNT(FactMSLPartnerUsage[UsageDate]), 0)",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "50650654-08f9-f3fc-c371-6c8884ab54d0"
          },
          {
            "name": "MSL Queries Per MSL Per Day",
            "expression": "DIVIDE([Total MSL Queries], DISTINCTCOUNT(FactMSLPartnerUsage[RepID]) * DISTINCTCOUNT(FactMSLPartnerUsage[UsageDate]), 0)",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "b63118ab-0e95-b2ba-4eb9-9bce27881245"
          },
          {
            "name": "Fully Answered Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(FactMSLPartnerUsage), FactMSLPartnerUsage[AnswerQuality] = \"Fully Answered\"), [Total MSL Queries], 0)",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "174f6fc4-34cf-5f99-af8e-75913fb8a010"
          },
          {
            "name": "Partially Answered Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(FactMSLPartnerUsage), FactMSLPartnerUsage[AnswerQuality] = \"Partially Answered\"), [Total MSL Queries], 0)",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "ebb5d118-cfcf-2da2-0a95-e586efab0a69"
          },
          {
            "name": "No Answer Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(FactMSLPartnerUsage), FactMSLPartnerUsage[AnswerQuality] = \"No Answer Found\"), [Total MSL Queries], 0)",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "b622848b-1b7f-f53f-09af-b474e8835add"
          },
          {
            "name": "Avg Time to Answer Sec",
            "expression": "AVERAGE(FactMSLPartnerUsage[TimeToAnswerSec])",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "21df5686-ef8d-58ad-5e4b-dc73007ef5b5"
          },
          {
            "name": "Total Time Saved Hours",
            "expression": "DIVIDE(SUM(FactMSLPartnerUsage[TimeSavedMinutes]), 60, 0)",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "0ee2ed42-4e32-1cbb-7dc7-30b8deefae95"
          },
          {
            "name": "Avg Time Saved Per Query Min",
            "expression": "AVERAGE(FactMSLPartnerUsage[TimeSavedMinutes])",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "888aa741-6250-125b-e095-f5c05f1272c3"
          },
          {
            "name": "Used in HCP Interaction Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(FactMSLPartnerUsage), FactMSLPartnerUsage[UsedInHCPInteraction] = 1), [Total MSL Queries], 0)",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "90a06495-97e9-c62b-6186-8099f4e448ce"
          },
          {
            "name": "Avg MSL Satisfaction",
            "expression": "AVERAGE(FactMSLPartnerUsage[UserSatisfaction])",
            "displayFolder": "MSL Partner Usage",
            "lineageTag": "7e84f35c-7be7-61ae-3845-fad70f385fd2"
          },
          {
            "name": "Total Experiments",
            "expression": "COUNTROWS(DimExperiment)",
            "displayFolder": "Experiment Tracking",
            "lineageTag": "00b344f6-03ff-13a9-263d-ee413073e13a"
          },
          {
            "name": "Concluded Experiments",
            "expression": "CALCULATE(COUNTROWS(DimExperiment), LEFT(DimExperiment[Status], 9) = \"Concluded\")",
