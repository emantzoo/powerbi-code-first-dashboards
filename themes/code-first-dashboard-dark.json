{
  "name": "Code-First Dashboard Dark",
  "dataColors": [
    "#60A5FA",
    "#34D399",
    "#FBBF24",
    "#F87171",
    "#A78BFA",
    "#22D3EE",
    "#FB923C",
    "#F472B6",
    "#818CF8",
    "#2DD4BF"
  ],
  "background": "#0F172A",
  "foreground": "#F1F5F9",
  "tableAccent": "#60A5FA",
  "maximum": "#F87171",
  "center": "#FBBF24",
  "minimum": "#34D399",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#94A3B8"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#F1F5F9"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#F1F5F9"
    },
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 28,
      "color": "#F1F5F9"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{
          "show": true,
          "color": {"solid": {"color": "#1E293B"}},
          "transparency": 0
        }],
        "border": [{
          "show": true,
          "color": {"solid": {"color": "#334155"}},
          "radius": 8
        }],
        "visualHeader": [{
          "show": false
        }],
        "title": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 11,
          "fontColor": {"solid": {"color": "#CBD5E1"}},
          "alignment": "left"
        }],
        "padding": [{
          "top": 8,
          "bottom": 8,
          "left": 12,
          "right": 12
        }],
        "categoryAxis": [{
          "show": true,
          "showAxisTitle": false,
          "fontSize": 9,
          "fontFamily": "Segoe UI",
          "fontColor": {"solid": {"color": "#94A3B8"}},
          "gridlineShow": false
        }],
        "valueAxis": [{
          "show": true,
          "showAxisTitle": false,
          "fontSize": 9,
          "fontFamily": "Segoe UI",
          "fontColor": {"solid": {"color": "#94A3B8"}},
          "gridlineShow": true,
          "gridlineStyle": "dashed",
          "gridlineColor": {"solid": {"color": "#334155"}}
        }]
      }
    },
    "page": {
      "*": {
        "background": [{
          "color": {"solid": {"color": "#0F172A"}},
          "transparency": 0
        }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridHorizontal": true,
          "gridHorizontalColor": {"solid": {"color": "#334155"}},
          "gridVertical": false,
          "rowPadding": 4
        }],
        "columnHeaders": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 10,
          "fontColor": {"solid": {"color": "#FFFFFF"}},
          "backColor": {"solid": {"color": "#3B82F6"}}
        }],
        "values": [{
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "fontColor": {"solid": {"color": "#E2E8F0"}},
          "backColor": {"solid": {"color": "#1E293B"}},
          "backColorAlternate": {"solid": {"color": "#0F172A"}}
        }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{
          "gridHorizontal": true,
          "gridHorizontalColor": {"solid": {"color": "#334155"}},
          "gridVertical": false,
          "rowPadding": 4
        }],
        "columnHeaders": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 10,
          "fontColor": {"solid": {"color": "#FFFFFF"}},
          "backColor": {"solid": {"color": "#3B82F6"}}
        }],
        "values": [{
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "fontColor": {"solid": {"color": "#E2E8F0"}},
          "backColor": {"solid": {"color": "#1E293B"}},
          "backColorAlternate": {"solid": {"color": "#0F172A"}}
        }],
        "rowHeaders": [{
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "fontColor": {"solid": {"color": "#E2E8F0"}}
        }]
      }
    },
    "cardVisual": {
      "*": {
        "cards": [{
          "fontSize": 28,
          "fontFamily": "Segoe UI Light"
        }]
      }
    },
    "slicer": {
      "*": {
        "items": [{
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "fontColor": {"solid": {"color": "#E2E8F0"}},
          "background": {"solid": {"color": "#1E293B"}}
        }],
        "header": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 10,
          "fontColor": {"solid": {"color": "#F1F5F9"}}
        }],
        "selection": [{
          "selectAllCheckboxEnabled": false,
          "singleSelect": false
        }]
      }
    },
    "tooltip": {
      "*": {
        "background": [{
          "color": {"solid": {"color": "#0F172A"}},
          "transparency": 5
        }],
        "title": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 11,
          "fontColor": {"solid": {"color": "#F1F5F9"}}
        }],
        "values": [{
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "fontColor": {"solid": {"color": "#CBD5E1"}}
        }]
      }
    }
  }
}
